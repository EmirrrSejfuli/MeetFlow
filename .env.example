# PostgreSQL (local Docker)
POSTGRES_DB=meetflow
POSTGRES_USER=meetflow
POSTGRES_PASSWORD=replace_with_your_own_password

# Google Calendar OAuth (host's account)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/google-calendar/callback
GOOGLE_REFRESH_TOKEN=replace_with_private_refresh_token

# Gemini AI
GEMINI_API_KEY=replace_with_private_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite
