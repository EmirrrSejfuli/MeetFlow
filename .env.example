# Local PostgreSQL (Docker Compose)
POSTGRES_DB=meetflow
POSTGRES_USER=meetflow
POSTGRES_PASSWORD=replace_with_a_local_password

# Render: DATABASE_URL is set to the database's Internal Database URL.
# Do not set DATABASE_URL for local Docker usage.
# DATABASE_URL=postgresql://user:password@host/database

# Google Calendar: OPTIONAL. Leave GOOGLE_REFRESH_TOKEN empty to use only PostgreSQL.
# Connected Calendar conflicts are checked and displayed as unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google-calendar/callback
GOOGLE_REFRESH_TOKEN=

# Gemini AI: OPTIONAL. Without a key the standard confirmation still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Deployment: set FRONTEND_URL on Render API; VITE_API_URL on Render Static Site.
# FRONTEND_URL=https://meetflow-web-xtoh.onrender.com
# VITE_API_URL=https://meetflow-api-xbsu.onrender.com
